#!/usr/bin/env python3

"""Extract the custom "word" under the tmux mouse position.

Unlike #{mouse_word}, this lets us define our own separators.
Currently, spaces are the only separators.
"""

import subprocess
import sys


def main():
    if len(sys.argv) != 4:
        print("Usage: tmux-mouse-word <pane> <x> <y>", file=sys.stderr)
        sys.exit(1)

    pane = sys.argv[1]
    x = int(sys.argv[2])
    y = int(sys.argv[3])

    out = subprocess.run(
        ["tmux", "capture-pane", "-p", "-t", pane, "-S", str(y), "-E", str(y)],
        capture_output=True,
        text=True,
    ).stdout

    line = out.rstrip("\n")

    if x >= len(line):
        return

    start, end = x, x

    while start > 0 and line[start - 1] != " ":
        start -= 1

    while end < len(line) and line[end] != " ":
        end += 1

    print(line[start:end])


if __name__ == "__main__":
    main()
