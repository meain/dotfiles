#!/bin/sh
# Show running AI agents and their status, switch to selected window/pane.
#
# Source of truth is the live process tree (via ,tmux-agent-scan); the
# aistatus/pid-<pid>.json files are only used as a status/project lookup,
# and are cleaned up here once their pid is no longer alive.

set -e

STATUS_DIR="$HOME/.local/share/aistatus"
NOW=$(date +%s)
STALE_SECS=7200

SCAN=$("$(dirname "$0")/,tmux-agent-scan" 2>/dev/null)
[ -z "$SCAN" ] && echo "No active AI agents" && exit 0

# Drop status files for pids that are no longer running anywhere.
if [ -d "$STATUS_DIR" ]; then
    for file in "$STATUS_DIR"/pid-*.json; do
        [ -f "$file" ] || continue
        pid=$(basename "$file" .json | sed 's/^pid-//')
        kill -0 "$pid" 2>/dev/null || rm -f "$file"
    done
fi

ENTRIES=""
while IFS='	' read -r PANE_ID WINDOW_ID SESSION WINDOW_NAME PANE_PATH PID AGENT_NAME; do
    [ -n "$PID" ] || continue

    FILE="$STATUS_DIR/pid-${PID}.json"
    STATUS=""
    AGENT="$AGENT_NAME"
    PROJECT=""
    if [ -f "$FILE" ]; then
        TS=$(jq -r '.timestamp // 0' "$FILE" 2>/dev/null)
        AGE=$((NOW - ${TS:-0}))
        if [ -n "$TS" ] && [ "$TS" != "0" ] && [ "$AGE" -le "$STALE_SECS" ]; then
            STATUS=$(jq -r '.status // empty' "$FILE" 2>/dev/null)
            PROJECT=$(jq -r '.project // empty' "$FILE" 2>/dev/null)
        fi
    fi
    [ -z "$STATUS" ] && STATUS="idle"
    [ -z "$PROJECT" ] && PROJECT=$(basename "$PANE_PATH")

    case "$STATUS" in
        working) INDICATOR="$(printf '\033[32m▶\033[0m')" ;;
        waiting) INDICATOR="$(printf '\033[33m●\033[0m')" ;;
        idle)    INDICATOR="$(printf '\033[90m○\033[0m')" ;;
        *)       INDICATOR=" " ;;
    esac

    POPUP_TAG=""
    if [ "$SESSION" = "popup-floater" ]; then
        POPUP_TAG=" $(printf '\033[34m[popup]\033[0m')"
    fi

    ENTRIES="$ENTRIES$WINDOW_ID	$PANE_ID	$PANE_ID	$INDICATOR [$AGENT] $PROJECT ($WINDOW_NAME) — $STATUS$POPUP_TAG\n"
done <<EOF
$SCAN
EOF

[ -z "$ENTRIES" ] && echo "No active AI agents" && exit 0

SELECTED=$(printf "%b" "$ENTRIES" \
    | fzf --ansi -d "	" --with-nth=4 --prompt='agent: ' \
        --preview 'tmux capture-pane -t {3} -p -e 2>/dev/null | awk "NF{blank=0;print} !NF{blank++;if(blank<3)print}" | tail -n $FZF_PREVIEW_LINES' \
        --preview-window 'right:70%' \
        --height=100% \
        --bind "alt-enter:execute(printf 'Message: '; read -r msg; [ -n \"\$msg\" ] && tmux send-keys -t {3} \"\$msg\" Enter)" \
        || true)

[ -z "$SELECTED" ] && exit 0

TARGET_WINDOW=$(echo "$SELECTED" | cut -f1)
TARGET_PANE=$(echo "$SELECTED" | cut -f2)

TARGET=$(tmux list-windows -a -F '#{session_name}:#{window_id}' 2>/dev/null \
    | awk -F: -v id="$TARGET_WINDOW" '$2 == id { print $1 ":" $2 }')

[ -z "$TARGET" ] && exit 0

# Select the specific pane first so switch-client lands on it
[ -n "$TARGET_PANE" ] && tmux select-pane -t "$TARGET_PANE" 2>/dev/null || true

tmux switch-client -t "$TARGET"
