#!/usr/bin/env ruby
# Show my PRs by status, PRs needing my review, and Jira sprint tickets.

require "json"
require "yaml"
require "open3"
require "time"

IGNORE_FILE = "/Users/meain/.local/share/ignored-prs-for-review.yaml"

BOLD = "\e[1m"
DIM = "\e[2m"
RESET = "\e[0m"

MY_PRS_QUERY = <<~GRAPHQL
  {
    search(query: "is:pr is:open author:meain org:Veeam-VDC", type: ISSUE, first: 30) {
      nodes {
        ... on PullRequest {
          number title url isDraft reviewDecision createdAt
          repository { nameWithOwner }
        }
      }
    }
  }
GRAPHQL

REVIEW_REQUESTED_QUERY = <<~GRAPHQL
  {
    search(query: "is:pr is:open review-requested:meain review:required org:Veeam-VDC", type: ISSUE, first: 30) {
      nodes {
        ... on PullRequest {
          number title url isDraft createdAt
          repository { nameWithOwner }
          author { login }
        }
      }
    }
  }
GRAPHQL

def gh_graphql(query)
  stdout, _stderr, status = Open3.capture3("gh", "api", "graphql", "-f", "query=#{query}")
  raise "gh api graphql failed" unless status.success?

  JSON.parse(stdout).dig("data", "search", "nodes")
end

def load_ignore_patterns
  return [] unless File.exist?(IGNORE_FILE)

  (YAML.load_file(IGNORE_FILE) || {}).values.flatten.compact
end

def ignored?(patterns, *fields)
  text = fields.join(" ")
  patterns.any? { |p| text.include?(p) }
end

def print_entry(item, show_meta: true, meta_first: false, meta_width: 0)
  title = item[:title]
  meta = show_meta ? item[:meta] : nil
  line =
    if meta.nil?
      title
    elsif meta_first
      "#{meta.ljust(meta_width)}  #{title}"
    else
      "#{title} (#{meta})"
    end
  line += " #{item[:extra]}" if item[:extra]
  puts line
  puts "#{DIM}#{item[:url]}#{RESET}" if item[:url]
end

def print_section(title, items, show_meta: true, meta_first: false)
  return if items.empty?

  puts "#{BOLD}#{title}#{RESET}"
  # align titles by padding the meta column to the widest entry
  meta_width = meta_first ? items.map { |i| i[:meta].to_s.length }.max : 0
  items.each do |item|
    print_entry(item, show_meta: show_meta, meta_first: meta_first, meta_width: meta_width)
  end
  puts
end

def pr_age(created_at)
  days = ((Time.now - Time.parse(created_at)) / 86400).floor
  return "today" if days.zero?

  days == 1 ? "1 day open" : "#{days} days open"
end

def fetch_my_prs
  gh_graphql(MY_PRS_QUERY).map do |n|
    meta = n["isDraft"] ? "DRAFT" : (n["reviewDecision"] || "PENDING")
    { title: n["title"], meta: meta, url: n["url"], extra: "(#{pr_age(n["createdAt"])})" }
  end
end

def fetch_review_requested(patterns)
  gh_graphql(REVIEW_REQUESTED_QUERY).map do |n|
    next if n["isDraft"]

    repo = n["repository"]["nameWithOwner"]
    author = n["author"]["login"]
    next if repo == "Veeam-VDC/vdc-shared-data-plane" || author == "dependabot[bot]"
    next if ignored?(patterns, repo, n["url"], author)

    { title: n["title"], meta: author, url: n["url"], extra: "(#{pr_age(n["createdAt"])})" }
  end.compact
end

def format_duration(minutes)
  hours, mins = minutes.divmod(60)
  return "#{mins}m" if hours.zero?

  mins.zero? ? "#{hours}h" : "#{hours}h#{mins}m"
end

# "8:00 AM - 4:00 PM" -> ["08:00 AM - 04:00 PM", "8h"]
# falls back to the raw range (no duration) when it is unparseable
def event_times(range)
  start_s, end_s = range.split("-", 2).map { |p| p.tr("\u{202f}\u{2060}", " ").gsub(" at ", " ").strip }
  raise ArgumentError unless start_s && end_s

  start_t = Time.parse(start_s)
  end_t = Time.parse(end_s)
  end_t += 24 * 60 * 60 if end_t < start_t # crosses midnight
  display = "#{start_t.strftime('%I:%M %p')} - #{end_t.strftime('%I:%M %p')}"
  [display, format_duration(((end_t - start_t) / 60).round)]
rescue ArgumentError, TypeError
  [range, nil]
end

def fetch_calendar_events
  out, _stderr, status = Open3.capture3("icalBuddy", "-nc", "-npn", "-b", "", "-iep", "title,datetime", "eventsToday")
  return [] unless status.success?

  events = []
  out.lines.each do |line|
    next if line.strip.empty?

    if line.start_with?(" ", "\t") && !events.empty?
      # indented lines are the datetime for the preceding title
      events.last[:meta], events.last[:extra] = event_times(line.strip)
    else
      # all-day events have no datetime line at all
      events << { title: line.strip, meta: "all day", url: nil }
    end
  end
  events
end

def fetch_jira_sprint
  sprint_out, = Open3.capture3("jira", "sprint", "list", "--plain")
  sprint_line = sprint_out.lines.find { |l| l.downcase.include?("earn") && l.downcase.include?("active") }
  return nil unless sprint_line

  sprint_id = sprint_line.split.first

  issues_out, = Open3.capture3(
    "jira", "issue", "list", "-q",
    "assignee = currentUser() AND sprint = #{sprint_id} AND status != Done", "--plain"
  )
  issues_out.lines.drop(1).map do |line|
    cols = line.chomp.split("\t")
    next if cols.length < 3

    { key: cols[1], title: cols[2], status: cols[-1] }
  end.compact
end

def main
  patterns = load_ignore_patterns
  my_prs = fetch_my_prs
  tickets = fetch_jira_sprint || []

  print_section("Today's calendar", fetch_calendar_events, meta_first: true)
  print_section("Approved PRs", my_prs.select { |pr| pr[:meta] == "APPROVED" }, show_meta: false)
  print_section("Changes requested", my_prs.select { |pr| pr[:meta] == "CHANGES_REQUESTED" }, show_meta: false)
  print_section("Chase review", my_prs.reject { |pr| %w[APPROVED DRAFT CHANGES_REQUESTED].include?(pr[:meta]) })
  print_section("PRs to review", fetch_review_requested(patterns))
  print_section("Draft PRs", my_prs.select { |pr| pr[:meta] == "DRAFT" }, show_meta: false)
  print_section("Pending Jira tickets", tickets.map do |t|
    { title: t[:title], meta: t[:status], url: "https://veeam-vdc.atlassian.net/browse/#{t[:key]}" }
  end)
end

main
