#!/bin/sh

set -e

duration="${1:-5m}"

count="$(echo "$duration" | sed -E 's|^([0-9]+)[hms]$|\1|')"
unit="$(echo "$duration" | sed -E 's|^[0-9]+([hms]?)$|\1|')"

multiplier=""
case "$unit" in
"s") multiplier="" ;;
"m") multiplier=" * 60" ;;
"") multiplier=" * 60" ;; # empty is also minutes
"h") multiplier=" * 60 * 60" ;;
*) echo "Unknown unit" && exit 1 ;;
esac

format_time() {
    t=$1
    h=$(($t / 3600))
    m=$(($t % 3600 / 60))
    s=$(($t % 60))

    result=""
    if [ "$h" -gt 0 ]; then
        result="${h}h"
    fi
    if [ "$m" -gt 0 ] || [ "$h" -gt 0 ]; then
        result="${result}${m}m"
    fi
    result="${result}${s}s"
    echo "$result"
}

seconds="$(($count$multiplier))"
tick="$seconds"
spinner="|/-\\"
while [ "$tick" -ge "1" ]; do
    spin_char="$(echo "$spinner" | cut -c$(( (($seconds - $tick) % 4) + 1 )))"
    printf "%s %s left      \r" "$spin_char" "$(format_time $tick)"
    tick="$(($tick - 1))"
    sleep 1
done
printf "\rTime up (%s)      \n" "$duration" # extra space to clean up line
notify "Time up" "Timer you set for $duration complete"
,make-noise notify
