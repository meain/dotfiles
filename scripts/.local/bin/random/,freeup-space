#!/bin/sh
# Pick cleanup commands from a multi-select list and run the selected ones

set -e

has() { command -v "$1" >/dev/null 2>&1; }

commands() {
    echo "trash-empty -f"
    echo "rm -rf ~/.local/share/rr"
    echo "nix-collect-garbage -d"
    echo "nix-collect-garbage"
    echo "nix-store --optimize"
    echo "docker system prune -a -f"
    has brew && echo "brew cleanup"
    has gem && echo "gem cleanup"
    has yarn && echo "yarn cache clean"
    has npm && echo "npm cache clean --force"
    has pip && echo "pip cache purge"
    has uv && echo "uv cache clean"
    [ -e "$HOME/Library/Caches/CocoaPods" ] && echo "rm -rf ~/Library/Caches/CocoaPods"
    if has xcrun; then
        echo "xcrun simctl delete unavailable"
        echo "rm -rf ~/Library/Developer/Xcode/Archives"
        echo "rm -rf ~/Library/Developer/Xcode/DerivedData"
        echo "rm -rf \"\$HOME/Library/Developer/Xcode/iOS Device Logs/\""
    fi
    echo "go clean -cache"
}

selected=$(commands | ,picker -m -p "freeup> ") || exit 0
[ -z "$selected" ] && exit 0

echo "$selected" | while IFS= read -r cmd; do
    echo ">>> $cmd"
    sh -c "$cmd" || echo "!!! failed: $cmd"
done
