#!/bin/sh
# Add a minimal repl for fin

set -e

read_user_input() {
	printf '\033[0;34m→\033[0m '
	IFS= read -e -r message # -e allow for arrow keys and other niceties
	if [ -z "$message" ]; then
		read_user_input
	fi
}

read_user_input
fin "$@" "$message" # optionally take in fin args
echo

session="$(fin -export json|jq -r .id)" # ensure that we reuse the session
while read_user_input; do
	fin -session "$session" -c "$message"
	echo
done
