#!/bin/sh

set -e

dir="$HOME/.local/share/chills"
mkdir -p "$dir" && cd "$dir"

download() {
    name="$(echo "$1" | awk '{print $1}')"
    url="$(echo "$1" | awk '{print $2}')"
    if [ ! -f "$name" ]; then
        yt-dlp -f 'bestaudio[ext=m4a]' --output "$name" "$url"
    else
        echo INFO: "$name" already available
    fi
}

if [ "$1" = "cache" ]; then
    while read -r line; do
        download "$line" || echo ERROR: Could not download "$line"
    done <"$HOME/.config/datafiles/chills"
    exit 0
fi

duration_of() {
    file="$dir/$1"
    [ -f "$file" ] || { echo "-"; return; }
    secs="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)"
    [ -n "$secs" ] || { echo "-"; return; }
    secs="${secs%.*}"
    printf '%d:%02d:%02d\n' $((secs / 3600)) $(((secs / 60) % 60)) $((secs % 60))
}

if echo "$1" | grep -q '^https://'; then
    key="$(echo "$1" | grep -o 'v=.*$')"
    item="$key $1"
else
    name="$(
        while read -r line; do
            n="$(echo "$line" | awk '{print $1}')"
            printf '%-30s %s\n' "$n" "$(duration_of "$n")"
        done <"$HOME/.config/datafiles/chills" | ,picker -l 10 | awk '{print $1}'
    )"
    url="$(awk -v n="$name" '$1==n{print $2}' "$HOME/.config/datafiles/chills")"
    item="$name $url"
fi

download "$item"
name="$(echo "$item" | awk '{print $1}')"
mpv --loop-file "$name" --input-ipc-server=/tmp/mpvsocket
