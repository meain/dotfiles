#!/usr/bin/env bash
set -euo pipefail

# Get the latest weekly report page
pages="$(confluence children "$IC_WEEKLY_REPORTS_CONFLUENCE_PAGE" --format json)"
url="$(echo "$pages" | jq -r '.children[-1].url')"
id="$(echo "$pages" | jq -r '.children[-1].id')"

# Find people with empty updates
missing=$(confluence read "$id" | awk '
/^[A-Z]/ && !/^(What|Blockers|Upcoming|Unplanned|Discussion|----)/ { name = $0; has_content = 0; has_empty = 0 }
/^What I worked on:/ { in_section = 1; next }
/^What/ || /^Blockers/ || /^Upcoming/ || /^Unplanned/ { 
    if (in_section && has_empty && !has_content && name) print name
    in_section = 0
    has_content = 0
    has_empty = 0
}
in_section && /^[[:space:]]*\*[[:space:]]*$/ { has_empty = 1; next }
in_section && /^[[:space:]]*\*[[:space:]]/ { has_content = 1 }
END {
    if (in_section && has_empty && !has_content && name) print name
}
' | paste -sd ', ' -)

# Get week date (Monday of current week)
week_date=$(date -v-Mon +%Y-%m-%d 2>/dev/null || date -d 'last monday' +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)

# Generate message
if [ -n "$missing" ]; then
    cat << EOF | tee /dev/stderr | mdclip
[Updates for week of $week_date]($url)

Please submit your weekly updates today.

$missing
EOF
else
    echo "Everyone has submitted their updates!"
fi
