#!/bin/sh

set -e

if [ -z "$1" ]; then
	# No argument
	todo.sh list | head -n -2 | sort -k1n
	echo ""
	echo "$(basename "$0") N   : to open the links in task N"
	echo "$(basename "$0") N M : to open the links in tasks N through M"
elif [ -z "$2" ] && echo "$1" | grep -qE '^[0-9][0-9]*$'; then
	# Single number passed in, open that
	todo.sh 'do' "$1" | grep -E -o "https?://[^ ]*" | sort -u | xargs -I{} open '{}'
elif [ -n "$2" ] && echo "$1" | grep -qE '^[0-9][0-9]*$' && echo "$2" | grep -qE '^[0-9][0-9]*$'; then
	# Range paseed in, open all in range
	seq "$1" "$2" | while read; do
		todo.sh 'do' "$1" | grep -E -o "https?://[^ ]*"
	done |
		sort -u | xargs open
else
	# Forward it to underlying CLI
	todo.sh "$*"
fi
